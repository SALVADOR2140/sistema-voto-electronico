@* Vista: ConfirmacionExito.cshtml *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Voto Exitoso";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    @* Agregamos la clase 'pro-card' para el control de impresión *@
    <div class="card shadow-lg border-0 text-center p-5 pro-card" style="max-width: 600px; border-radius: 20px;">
        <div class="card-body">
            <div class="mb-4 no-print">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>

            @* Encabezado institucional que aparecerá en el PDF *@
            <div class="only-print mb-4" style="display:none;">
                <h2 style="color: #0d6efd;">UNIVERSIDAD TÉCNICA DEL NORTE</h2>
                <h4>SISTEMA DE VOTO ELECTRÓNICO</h4>
                <hr>
            </div>

            <h1 class="fw-bold text-dark mb-3">Certificado de Votación</h1>

            <p class="fs-5 text-muted">
                Por medio de la presente se certifica que el ciudadano ha participado con éxito en las <strong>Elecciones UTN 2026</strong>[cite: 1, 5].
            </p>

            @* Cambiamos el mensaje del correo por la instrucción de descarga *@
            <div class="alert alert-success d-flex align-items-center justify-content-center mt-4 no-print" role="alert">
                <i class="bi bi-file-earmark-pdf-fill me-2"></i>
                <div>
                    Tu voto ha sido procesado. Ya puedes <strong>descargar tu comprobante</strong> oficial.
                </div>
            </div>

            <div class="only-print mt-4 text-start" style="display:none;">
                <p><strong>Estado:</strong> Sufragio Completado [cite: 19]</p>
                <p><strong>Fecha:</strong> @DateTime.Now.ToString("f")</p>
                <p><strong>Código de Verificación:</strong> @Guid.NewGuid().ToString().Substring(0, 8).ToUpper()</p>
            </div>

            <hr class="my-4 no-print">

            <div class="d-grid gap-2 no-print">
                @* Botón de descarga directa *@
                <button onclick="window.print();" class="btn btn-success btn-lg shadow-sm mb-2">
                    <i class="bi bi-download me-2"></i>Descargar Certificado (PDF)
                </button>

                <a asp-controller="AccesoVotante" asp-action="Login" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-box-arrow-right me-2"></i>Finalizar y Salir
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos para que el PDF se vea profesional */
    @media print {
        .no-print

    {
        display: none !important;
    }

    .only-print {
        display: block !important;
    }

    .pro-card {
        box-shadow: none !important;
        border: 2px solid #eee !important;
        margin: 0 auto !important;
    }

    body {
        background-color: white !important;
    }

    }
</style>

@section Scripts {
    <script>
        window.history.pushState(null, "", window.location.href);
        window.onpopstate = function () {
            window.history.pushState(null, "", window.location.href);
        };
    </script>
}