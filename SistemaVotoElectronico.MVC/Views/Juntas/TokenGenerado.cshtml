@model SistemaVoto.Modelos.Usuario

@{
    ViewData["Title"] = "Token Enviado";
    Layout = "~/Views/Shared/_LayoutJunta.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card border-0 shadow-lg text-center" style="max-width: 500px; border-radius: 20px;">
        <div class="card-header bg-primary text-white py-3" style="border-radius: 20px 20px 0 0;">
            <h4 class="mb-0"><i class="fa-solid fa-envelope-circle-check me-2"></i> Proceso de Validación</h4>
        </div>

        <div class="card-body p-5">
            <h5 class="text-muted mb-1">Votante:</h5>
            <h3 class="fw-bold text-dark">@Html.DisplayFor(model => model.Nombres)</h3>
            <p class="text-secondary small">Cédula: @Html.DisplayFor(model => model.Cedula)</p>

            <hr class="my-4">

            @* Sección de Privacidad: Se oculta el Token *@
            <div class="bg-light py-4 rounded-3 border border-2 border-primary shadow-sm">
                <i class="fa-solid fa-paper-plane text-primary fa-3x mb-3"></i>
                <h4 class="text-primary fw-bold">TOKEN ENVIADO</h4>
                <p class="mb-0 px-3 text-muted">El código de acceso ha sido enviado de forma segura al correo del estudiante.</p>
            </div>

            <div class="mt-5">
                <a asp-action="Index" class="btn btn-primary btn-lg w-100 rounded-pill shadow">
                    <i class="fa-solid fa-user-check me-2"></i> Validar Siguiente
                </a>
            </div>
        </div>

        <div class="card-footer bg-white border-0 pb-4 text-center text-danger fw-bold">
            <i class="fa-solid fa-user-shield me-1"></i> Por seguridad, el código de votación es privado.
        </div>
    </div>
</div>