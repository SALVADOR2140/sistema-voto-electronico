@model SistemaVoto.Modelos.Usuario

@{
    ViewData["Title"] = "Control Electoral";
    Layout = "~/Views/Shared/_LayoutJunta.cshtml";
}

<style>
    body {
        background-color: #eef2f6;
        background-image: radial-gradient(circle at 10% 20%, rgb(239, 246, 255) 0%, rgb(225, 230, 240) 90%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .pro-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); 
        border: none;
        overflow: hidden;
    }

    .header-institutional {
        background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d); 
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); 
        color: white;
        padding: 2.5rem 2rem;
        text-align: center;
        position: relative;
    }

        .header-institutional h2 {
            font-weight: 700;
            letter-spacing: 0.5px;
        }

    .input-group-text {
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-right: none;
        color: #495057;
    }

    .input-cedula {
        font-size: 1.5rem; 
        font-weight: 600;
        letter-spacing: 2px;
        text-align: center;
        border: 2px solid #e9ecef;
        border-left: none;
        height: 60px;
        background-color: #fff;
        color: #2c3e50;
        transition: all 0.3s ease;
    }

        .input-cedula:focus {
            border-color: #2c5364;
            box-shadow: none; 
            background-color: #fff;
        }

            .input-cedula:focus + .input-group-text,
            .input-group:focus-within .input-group-text {
                border-color: #2c5364;
                color: #2c5364;
                background-color: #eef2f6;
            }

        .input-cedula::placeholder {
            font-size: 1.1rem;
            font-weight: 400;
            letter-spacing: normal;
            color: #adb5bd;
        }

    .btn-pro {
        background-color: #2c3e50; 
        color: white;
        padding: 16px;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        border: none;
        transition: all 0.3s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .btn-pro:hover {
            background-color: #1a252f;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            color: #fff;
        }

    .ticket-box {
        background-color: #f1f8e9; 
        border-left: 5px solid #43a047;
        padding: 20px;
        border-radius: 4px;
        margin-bottom: 25px;
        text-align: center;
    }

    .token-text {
        font-family: 'Consolas', 'Monaco', monospace;
        color: #2e7d32;
        font-weight: bold;
        font-size: 2.5rem;
        letter-spacing: 3px;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

</style>

<div class="container d-flex justify-content-center align-items-center fade-in" style="min-height: 85vh;">

    <div class="pro-card w-100" style="max-width: 500px;">

        <div class="header-institutional">
            <i class="fa-solid fa-building-columns fa-3x mb-3 opacity-50"></i>
            <h2 class="mb-1">Junta Receptora</h2>
            <p class="mb-0 small text-uppercase opacity-75" style="letter-spacing: 2px;">Sistema Oficial de Validación</p>
        </div>

        <div class="card-body p-4 p-md-5">

            @if (TempData["TokenGenerado"] != null)
            {
                <div class="ticket-box shadow-sm fade-in">
                    <div class="d-flex justify-content-center align-items-center mb-2">
                        <i class="fa-solid fa-circle-check text-success me-2"></i>
                        <span class="text-uppercase fw-bold text-success small">Habilitado para Votar</span>
                    </div>

                    <div class="token-text">@TempData["TokenGenerado"]</div>

                    <div class="mt-3 pt-3 border-top border-success border-opacity-25">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Votante</small>
                        <div class="fw-bold text-dark">@TempData["MensajeExito"]</div>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4 border-0 shadow-sm" style="background-color: #fff5f5; color: #c53030;">
                    <i class="fa-solid fa-triangle-exclamation fa-2x me-3"></i>
                    <div>
                        <strong class="d-block text-uppercase small ls-1">Error de Validación</strong>
                        <span class="small">@TempData["Error"]</span>
                    </div>
                </div>
            }

            <form asp-action="GenerarToken" method="post" autocomplete="off">
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary text-uppercase small mb-2">
                        Número de Identificación
                    </label>

                    <div class="input-group">
                        <span class="input-group-text px-3 bg-white">
                            <i class="fa-solid fa-id-card text-muted"></i>
                        </span>
                        <input type="text" name="cedula"
                               class="form-control input-cedula shadow-none"
                               placeholder="Ej: 1710020030"
                               required
                               maxlength="10"
                               autofocus
                               oninput="this.value = this.value.replace(/[^0-9]/g, '');">
                    </div>
                </div>

                <button type="submit" class="btn btn-pro w-100">
                    Generar Token <i class="fa-solid fa-chevron-right ms-2" style="font-size: 0.8em;"></i>
                </button>
            </form>

        </div>

        <div class="bg-light text-center py-3 border-top">
            <a asp-controller="Inicio" asp-action="Index" class="text-muted text-decoration-none fw-bold small">
                <i class="fa-solid fa-right-from-bracket me-1"></i> Cerrar Sesión
            </a>
        </div>
    </div>
</div>