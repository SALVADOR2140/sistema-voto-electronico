@model IEnumerable<SistemaVotoElectronico.Modelos.Votacion.Votante>

@{
    ViewData["Title"] = "Gestión de Padrón Electoral";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="display-6 fw-bold text-primary"><i class="fas fa-users-cog me-2"></i>Administración de Votantes</h2>
            <p class="text-muted">Carga el archivo Excel de los estudiantes habilitados para sufragar.</p>
            <hr />
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">Subir Padrón Electoral (.xlsx)</h5>
            <form asp-action="ImportarExcel" method="post" enctype="multipart/form-data">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <input type="file" name="archivoExcel" class="form-control" accept=".xlsx" required />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fas fa-file-import me-2"></i>Procesar e Importar
                        </button>
                    </div>
                    <div class="col-auto">
                        <span class="form-text text-muted">
                            Formato: Col A (Cédula) | Col B (Nombres) | Col C (Correo)
                        </span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Lista de Votantes Registrados (@Model.Count())</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-3">Cédula</th>
                            <th>Nombres Completos</th>
                            <th>Correo Electrónico</th>
                            <th class="text-center">Token de Acceso</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.Cedula</td>
                                <td>@item.Nombres</td>
                                <td>@item.Correo</td>
                                <td class="text-center">
                                    <code class="bg-light p-1 rounded text-danger fw-bold border">@item.Token</code>
                                </td>
                                <td class="text-center">
                                    @if (item.HaVotado)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Ya votó</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">Pendiente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>