@model SistemaVoto.Modelos.ListaPolitica

@{
    ViewData["Title"] = "Editar Lista";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Editar Organización</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Eslogan</label>
                            <input asp-for="Eslogan" class="form-control" />
                            <span asp-validation-for="Eslogan" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Evento Electoral</label>
                            <select asp-for="EventoElectoralId" class="form-select" asp-items="ViewBag.Eventos"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">URL del Logo</label>
                            <input asp-for="LogoUrl" class="form-control" id="imgUrlInput" oninput="previewImage(this.value)" />
                        </div>
                    </div>

                    <div class="col-md-4 text-center">
                        <label class="form-label fw-bold text-muted">Vista Previa</label>
                        <div class="p-3 border rounded bg-light">
                            <img id="imgPreview" src="@Model.LogoUrl" class="img-fluid rounded"
                                 style="max-height: 150px;"
                                 onerror="this.src='https://placehold.co/150x150?text=Sin+Imagen';" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 border-top pt-3 text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function previewImage(url) {
        document.getElementById('imgPreview').src = url;
    }
</script>