@model SistemaVoto.Modelos.ListaPolitica

@{
    ViewData["Title"] = "Eliminar Lista";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-danger text-white text-center py-3">
                    <i class="fa-solid fa-triangle-exclamation fa-3x mb-2"></i>
                    <h4 class="mb-0">¿Eliminar esta Lista?</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="lead mb-4">Estás a punto de eliminar la organización:</p>

                    <h2 class="fw-bold text-danger">@Model.Nombre</h2>
                    <p class="text-muted fst-italic">"@Model.Eslogan"</p>

                    <div class="alert alert-warning mt-4 text-start">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        <strong>Advertencia:</strong> Esta acción no se puede deshacer. Si hay candidatos asociados a esta lista, podrían quedar huérfanos.
                    </div>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-light border px-4 me-2">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">Sí, Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>