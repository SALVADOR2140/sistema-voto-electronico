@model SistemaVoto.Modelos.ListaPolitica

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h3 class="text-primary mb-3"><i class="fa-solid fa-flag me-2"></i>Nueva Organización Política</h3>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la Lista</label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Eslogan o Lema</label>
                <input asp-for="Eslogan" class="form-control" required />
                <span asp-validation-for="Eslogan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">URL del Logo (Imagen)</label>
                <input asp-for="LogoUrl" class="form-control" placeholder="http://ejemplo.com/logo.png" required />
                <span asp-validation-for="LogoUrl" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Evento Electoral Correspondiente</label>
                <select asp-for="EventoElectoralId" class="form-select" asp-items="ViewBag.Eventos" required>
                    <option value="">-- Seleccione un Evento --</option>
                </select>
                <span asp-validation-for="EventoElectoralId" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 d-md-block">
                <button type="submit" class="btn btn-primary px-5 shadow">
                    <i class="fa-solid fa-save me-2"></i>Registrar Lista
                </button>
                <a asp-action="Index" class="btn btn-light border px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>