@model SistemaVoto.Modelos.ListaPolitica

@{
    ViewData["Title"] = "Nueva Lista Política";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-plus me-2"></i>Registrar Organización</h4>
                </div>
                <div class="card-body p-4">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm rounded-3 mb-4">
                            <h5 class="fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Atención:</h5>
                            <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre de la Organización</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Lista 5 - Revolución" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Eslogan de Campaña</label>
                            <input asp-for="Eslogan" class="form-control" placeholder="Ej: ¡El cambio es ahora!" required />
                            <span asp-validation-for="Eslogan" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border">
                            <label class="form-label fw-bold d-block mb-2">Logotipo Oficial</label>

                            <div class="btn-group w-100 mb-3" role="group">
                                <input type="radio" class="btn-check" name="tipoCarga" id="radioArchivo" autocomplete="off" checked onchange="toggleImagenInput('archivo')">
                                <label class="btn btn-outline-primary" for="radioArchivo"><i class="fa-solid fa-upload me-2"></i>Subir Archivo</label>

                                <input type="radio" class="btn-check" name="tipoCarga" id="radioUrl" autocomplete="off" onchange="toggleImagenInput('url')">
                                <label class="btn btn-outline-primary" for="radioUrl"><i class="fa-solid fa-link me-2"></i>Pegar URL</label>
                            </div>

                            <div id="grupoArchivo">
                                <div class="input-group">
                                    <input type="file" name="logoArchivo" class="form-control" accept="image/*" id="inputLogoFile">
                                    <label class="input-group-text"><i class="fa-solid fa-image"></i></label>
                                </div>
                                <div class="form-text text-muted">Formatos: PNG, JPG.</div>
                            </div>

                            <div id="grupoUrl" class="d-none">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                                    <input type="text" name="logoUrlTexto" class="form-control" placeholder="Pegue aquí el enlace..." id="inputLogoUrl">
                                </div>
                                <div class="form-text text-muted">Asegúrese de que el enlace termine en .jpg o .png</div>
                            </div>

                            <div class="mt-3 text-center d-none" id="previewContainer">
                                <img id="imgPreview" src="#" alt="Vista Previa" class="rounded-circle shadow-sm border bg-white"
                                     style="width: 120px; height: 120px; object-fit: contain;"
                                     onerror="this.src='https://via.placeholder.com/120?text=Error';" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Evento Electoral</label>
                            <select asp-for="EventoElectoralId" class="form-select" asp-items="ViewBag.Eventos" required>
                                <option value="">-- Seleccione un Evento --</option>
                            </select>
                            <span asp-validation-for="EventoElectoralId" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Guardar Lista</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Toggle
    function toggleImagenInput(tipo) {
        const grupoArchivo = document.getElementById('grupoArchivo');
        const grupoUrl = document.getElementById('grupoUrl');
        const inputUrl = document.getElementById('inputLogoUrl');
        const inputArchivo = document.getElementById('inputLogoFile');

        document.getElementById('previewContainer').classList.add('d-none');
        document.getElementById('imgPreview').src = '';

        if (tipo === 'archivo') {
            grupoArchivo.classList.remove('d-none');
            grupoUrl.classList.add('d-none');
            inputUrl.value = '';
        } else {
            grupoArchivo.classList.add('d-none');
            grupoUrl.classList.remove('d-none');
            inputArchivo.value = '';
        }
    }

    // 2. Preview Archivo
    document.getElementById('inputLogoFile').addEventListener('change', function (evt) {
        const file = evt.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) { mostrarPreview(e.target.result); }
            reader.readAsDataURL(file);
        }
    });

    // 3. Preview URL
    document.getElementById('inputLogoUrl').addEventListener('input', function () {
        const url = this.value;
        if (url.length > 5) mostrarPreview(url);
    });

    function mostrarPreview(src) {
        document.getElementById('imgPreview').src = src;
        document.getElementById('previewContainer').classList.remove('d-none');
    }
</script>