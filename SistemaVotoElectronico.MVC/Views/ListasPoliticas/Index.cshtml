@model IEnumerable<SistemaVoto.Modelos.ListaPolitica>

@{
    ViewData["Title"] = "Listas Políticas";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">
                <i class="fa-solid fa-flag me-2 text-primary"></i>Listas Políticas
            </h2>
            <p class="text-muted">Gestión de organizaciones y partidos para el proceso electoral.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="fa-solid fa-plus me-2"></i> Nueva Lista
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3">Organización</th>
                        <th class="py-3">Eslogan</th>
                        <th class="py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@item.LogoUrl" class="rounded me-3 border"
                                         style="width: 45px; height: 45px; object-fit: contain; background: #fff;"
                                         onerror="this.src='https://placehold.co/45x45?text=Img';" />

                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">@item.Nombre</span>
                                        <small class="text-muted" style="font-size: 0.8rem;">
                                            @(item.EventoElectoral != null ? item.EventoElectoral.Nombre : "Evento ID: " + item.EventoElectoralId)
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="text-muted fst-italic">@item.Eslogan</span></td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-3 overflow-hidden">

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm border-0 px-3" title="Ver Detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm border-0 px-3" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm border-0 px-3" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-folder-open fa-3x text-muted mb-3 opacity-50"></i>
                    <p class="text-muted fw-bold">No hay listas registradas aún.</p>
                </div>
            }
        </div>
    </div>
</div>