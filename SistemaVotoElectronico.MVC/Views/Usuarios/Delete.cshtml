@model SistemaVoto.Modelos.Usuario

@{
    ViewData["Title"] = "Eliminar Votante";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-danger text-white p-4 text-center">
                    <i class="fa-solid fa-user-xmark fa-3x mb-2 opacity-75"></i>
                    <h3 class="fw-bold m-0">¿Eliminar Votante?</h3>
                    <p class="mb-0 opacity-75 small">Esta acción no se puede deshacer.</p>
                </div>

                <div class="card-body p-4 text-center">

                    <div class="mb-4">
                        <h4 class="fw-bold text-dark mb-1">@Model.Nombres</h4>
                        <p class="text-muted">C.I: @Model.Cedula</p>
                    </div>

                    <div class="alert alert-warning text-start small border-0 bg-warning bg-opacity-10 text-warning-emphasis">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Si elimina este usuario, <b>no podrá votar</b>. Si ya votó, su voto permanecerá anónimo pero el registro del estudiante desaparecerá del padrón.
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold rounded-pill">
                                Sí, Eliminar del Padrón
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>