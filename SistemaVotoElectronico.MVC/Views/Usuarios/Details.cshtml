@model SistemaVoto.Modelos.Usuario

@{
    ViewData["Title"] = "Detalles del Votante";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="fa-solid fa-id-card me-2 text-primary"></i>Detalles del Votante</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-gradient p-4 text-center text-white" style="background: linear-gradient(135deg, #6610f2 0%, #6f42c1 100%);">
                    <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-user fa-3x"></i>
                    </div>
                    <h3 class="fw-bold m-0">@Model.Nombres</h3>
                    <p class="opacity-75 mb-0">@Model.Correo</p>
                </div>

                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <h6 class="text-uppercase text-muted fw-bold small">Estado de Votación</h6>
                        @if (Model.YaVoto)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-check-circle me-2"></i>Ya Votó
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-clock me-2"></i>Pendiente
                            </span>
                        }
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border">
                                <small class="text-muted d-block fw-bold">Cédula de Identidad</small>
                                <span class="fs-5 text-dark fw-bold">@Model.Cedula</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border">
                                <small class="text-muted d-block fw-bold">Rol en Sistema</small>
                                <span class="fs-5 text-dark fw-bold">
                                    @(Model.RolUsuarioId == 1 ? "Administrador" : "Votante / Estudiante")
                                </span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded border">
                                <small class="text-muted d-block fw-bold">Token de Votación (Temporal)</small>
                                <code class="fs-5 text-primary fw-bold">@(Model.TokenVotacion ?? "N/A")</code>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 opacity-10">

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="fa-solid fa-arrow-rotate-left me-2"></i>Volver
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>