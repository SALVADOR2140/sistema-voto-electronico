@model SistemaVoto.Modelos.Candidato

@{
    ViewData["Title"] = "Editar Candidato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-warning bg-opacity-75 text-dark py-3">
                    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Editar Candidato</h4>
                </div>
                <div class="card-body p-4">

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FotoUrl" />
                        <input type="hidden" asp-for="PlanGobiernoUrl" /> <div class="mb-3">
                            <label class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombres" class="form-control" placeholder="Ej: Juan Pérez" required />
                            <span asp-validation-for="Nombres" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Cargo al que aspira</label>
                            <input asp-for="Cargo" class="form-control" placeholder="Ej: Presidente" required />
                            <span asp-validation-for="Cargo" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border">
                            <label class="form-label fw-bold mb-2">Fotografía</label>

                            <div class="d-flex align-items-center mb-3">
                                @{
                                    string imgAct = Model.FotoUrl;
                                    if (!string.IsNullOrEmpty(imgAct) && !imgAct.StartsWith("http") && !imgAct.StartsWith("data:"))
                                    {
                                        imgAct = $"data:image/png;base64,{imgAct}";
                                    }
                                }
                                @if (!string.IsNullOrEmpty(imgAct))
                                {
                                    <img src="@imgAct" class="rounded-circle border shadow-sm me-3 bg-white"
                                         style="width: 60px; height: 60px; object-fit: cover;"
                                         onerror="this.src='https://via.placeholder.com/60?text=?';" />
                                }
                                else
                                {
                                    <div class="rounded-circle border shadow-sm me-3 bg-white d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <i class="fa-solid fa-user text-muted"></i>
                                    </div>
                                }
                                <span class="small text-muted fst-italic">Foto actual</span>
                            </div>

                            <div class="btn-group w-100 mb-3">
                                <input type="radio" class="btn-check" name="tipoCarga" id="radioArchivo" checked onchange="toggleInput('archivo')">
                                <label class="btn btn-outline-primary btn-sm" for="radioArchivo"><i class="fa-solid fa-upload me-1"></i>Subir Archivo</label>

                                <input type="radio" class="btn-check" name="tipoCarga" id="radioUrl" onchange="toggleInput('url')">
                                <label class="btn btn-outline-primary btn-sm" for="radioUrl"><i class="fa-solid fa-link me-1"></i>Pegar URL</label>
                            </div>

                            <div id="grupoArchivo">
                                <input type="file" name="fotoArchivo" class="form-control" accept="image/*">
                            </div>
                            <div id="grupoUrl" class="d-none">
                                <input type="text" name="fotoUrlTexto" class="form-control" placeholder="https://ejemplo.com/foto.jpg">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Lista Política</label>
                            <select name="ListaPoliticaId" asp-for="ListaPoliticaId" class="form-select" asp-items="ViewBag.Listas">
                                <option value="">-- Sin Lista (Independiente) --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-center gap-2 mt-4">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 rounded-pill shadow-sm">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleInput(tipo) {
        if (tipo === 'archivo') {
            document.getElementById('grupoArchivo').classList.remove('d-none');
            document.getElementById('grupoUrl').classList.add('d-none');
        } else {
            document.getElementById('grupoArchivo').classList.add('d-none');
            document.getElementById('grupoUrl').classList.remove('d-none');
        }
    }
</script>